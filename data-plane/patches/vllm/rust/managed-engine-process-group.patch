+    /// Reap this group's adopted descendants only after Tokio has reaped its launcher.
+    /// A container PID 1 may inherit them; other children retain their own process groups.
+    pub fn reap_adopted(pid: u32) -> Result<()> {
+        loop {
+            let result =
+                unsafe { libc::waitpid(-(pid as i32), std::ptr::null_mut(), libc::WNOHANG) };
+            if result > 0 {
+                continue;
+            }
+            if result == 0 {
+                return Ok(());
+            }
+            let error = io::Error::last_os_error();
+            match error.raw_os_error() {
+                Some(libc::ECHILD) => return Ok(()),
+                Some(libc::EINTR) => continue,
+                _ => return Err(error).context("failed to reap managed engine descendants"),
+            }
+        }
+    }
+
+    /// Probe all members, even after the original group leader has exited.
+    pub fn exists(pid: u32) -> Result<bool> {
+        if unsafe { libc::kill(-(pid as i32), 0) } == 0 {
+            return Ok(true);
+        }
+        let error = io::Error::last_os_error();
+        if error.raw_os_error() == Some(libc::ESRCH) {
+            return Ok(false);
+        }
+        Err(error).context("failed to inspect managed engine process group")
     }
 
